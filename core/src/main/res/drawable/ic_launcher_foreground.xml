<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Recessed dark camera lens socket -->
    <path
        android:pathData="M38.2,54 A15.8,15.8 0 1,0 69.8,54 A15.8,15.8 0 1,0 38.2,54 Z"
        android:strokeColor="#FF46433D"
        android:strokeWidth="1.0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="16.5"
                android:type="radial">
                <item android:color="#FF080807" android:offset="0.0" />
                <item android:color="#FF0C0C0B" android:offset="0.82" />
                <item android:color="#FF181715" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Warm ivory Open-360 ring (298-deg sweep, open at upper-right -45 deg) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M76.32,48.44 A23,23 0 1,1 59.56,31.68"
        android:strokeColor="#FFF0EBE1"
        android:strokeLineCap="round"
        android:strokeWidth="5.2" />

    <!-- Orbital / GPS node nestled in the upper-right opening -->
    <path
        android:fillColor="#FFF0EBE1"
        android:pathData="M66.76,37.74 A3.5,3.5 0 1,0 73.76,37.74 A3.5,3.5 0 1,0 66.76,37.74 Z" />

    <!-- Signature recording-red tactile shutter core -->
    <path android:pathData="M43.6,54 A10.4,10.4 0 1,0 64.4,54 A10.4,10.4 0 1,0 43.6,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="51.09"
                android:centerY="49.84"
                android:gradientRadius="15.39"
                android:type="radial">
                <item android:color="#FFFF766B" android:offset="0.0" />
                <item android:color="#FFFF5449" android:offset="0.52" />
                <item android:color="#FFD4352B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
